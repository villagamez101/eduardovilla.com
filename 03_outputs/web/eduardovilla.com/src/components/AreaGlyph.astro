---
/**
 * Glifo de área — íconos de trazo dibujados a mano, un solo peso y
 * remate redondeado para las seis áreas. Decorativo: el título del
 * área ya nombra el contenido, así que se oculta a tecnologías de
 * asistencia.
 */
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: cls } = Astro.props;
---

<svg
  class:list={["area-card__glyph", cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {slug === "diseno-grafico" && (
    <>
      <path d="M4.5 19.5l4-1L19 8l-3-3L5.5 15.5l-1 4z" />
      <path d="M14.5 6.5l3 3" />
      <path d="M5.5 15.5l3 3" />
    </>
  )}
  {slug === "branding-marca" && (
    <>
      <path d="M12 3.2l7.2 4.1v9.4L12 20.8l-7.2-4.1V7.3L12 3.2z" />
      <circle cx="12" cy="12" r="2.6" />
    </>
  )}
  {slug === "desarrollo-web" && (
    <>
      <path d="M8.5 8l-4 4 4 4" />
      <path d="M15.5 8l4 4-4 4" />
      <path d="M13.2 6l-2.4 12" />
    </>
  )}
  {slug === "marketing-digital" && (
    <>
      <path d="M4 10.5v3a1.2 1.2 0 001.2 1.2H7l6.5 3.6V5.7L7 9.3H5.2A1.2 1.2 0 004 10.5z" />
      <path d="M16.6 9.2a4 4 0 010 5.6" />
      <path d="M19 7a7 7 0 010 10" />
    </>
  )}
  {slug === "comercio-electronico" && (
    <>
      <path d="M5.8 8h12.4l-1.1 11.1a1 1 0 01-1 .9H7.9a1 1 0 01-1-.9L5.8 8z" />
      <path d="M9 8V6.2a3 3 0 016 0V8" />
    </>
  )}
  {slug === "inteligencia-artificial" && (
    <>
      <circle cx="12" cy="12" r="2.2" />
      <circle cx="5" cy="6" r="2" />
      <circle cx="19" cy="6" r="2" />
      <circle cx="12" cy="19.5" r="2" />
      <path d="M6.4 7.4l3.5 3.3M17.6 7.4l-3.5 3.3M12 14.2v3.3" />
    </>
  )}
</svg>
