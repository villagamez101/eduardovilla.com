---
import { t, getLang } from "@i18n/ui";
import Logo from "@components/Logo.astro";
import SocialLinks from "@components/SocialLinks.astro";
import contacto from "@data/contacto.json";

interface Props {
  lang: "es" | "en";
}
const { lang } = Astro.props;
const l = getLang(lang);
const base = lang === "en" ? "/en" : "";
const year = new Date().getFullYear();
const wa = `https://wa.me/${contacto.whatsapp}`;
const frase =
  lang === "es"
    ? "Más que un sitio web, este es mi refugio digital."
    : "More than a website — this is my digital refuge.";
const nav = [
  { href: `${base}/acerca`, label: t.nav.acerca },
  { href: `${base}/areas`, label: t.nav.areas },
  { href: `${base}/proyectos`, label: t.nav.proyectos },
  { href: `${base}/blog`, label: t.nav.blog },
  { href: `${base}/contacto`, label: t.nav.contacto },
];
---
<footer class="relative mt-28 border-t border-line px-[var(--gutter)] pt-14">
  <div class="mx-auto grid w-full max-w-[var(--max-w)] gap-12 md:grid-cols-[1.5fr_1fr_1.2fr] md:gap-14">
    <!-- 01 · Marca -->
    <div class="flex flex-col gap-5 border-t border-[var(--line)] pt-5">
      <a href={`${base}/`} class="logo flex items-center gap-2.5">
        <Logo class="h-10 w-10" />
        <span class="font-bold tracking-tight">Eduardo Villa</span>
      </a>
      <p class="max-w-xs text-sm ink-soft">{frase}</p>
      <p class="flex items-center gap-2.5 text-sm ink-soft">
        <span class="status-dot" aria-hidden="true"></span>
        {t.footer.disponible[l]}
      </p>
    </div>

    <!-- 02 · Navegación -->
    <nav
      class="flex flex-col gap-4 border-t border-[var(--line)] pt-5"
      aria-label={lang === "es" ? "Pie de página" : "Footer"}
    >
      <p class="label">{t.footer.navegacion[l]}</p>
      <ul class="flex flex-col gap-2 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-[var(--ink-soft)] transition-colors hover:text-[var(--accent-text)]"
            >
              {item.label[l]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 03 · Contacto -->
    <div class="flex flex-col gap-4 border-t border-[var(--line)] pt-5">
      <p class="label">{t.footer.contacto[l]}</p>
      <div class="flex flex-col gap-2 text-sm">
        <a class="link-accent w-fit" href={`mailto:${contacto.email}`}>{contacto.email}</a>
        <a class="link-accent w-fit" href={wa} target="_blank" rel="noopener">{contacto.telefono}</a>
        <span class="w-fit ink-soft">{contacto.ubicacion}</span>
      </div>
      <SocialLinks
        class="mt-1"
        x={contacto.x}
        github={contacto.github}
        instagram={contacto.instagram}
        linkedin={contacto.linkedin}
        behance={contacto.behance}
      />
    </div>
  </div>

  <!-- Copyright centrado -->
  <div class="mx-auto mt-16 w-full max-w-[var(--max-w)] border-t border-line py-7">
    <p class="text-center text-xs ink-faint">
      © {year} Eduardo Villa · {t.footer.hecho[l]} · <a class="link-accent" href="/rss.xml">RSS</a>
    </p>
  </div>
</footer>
