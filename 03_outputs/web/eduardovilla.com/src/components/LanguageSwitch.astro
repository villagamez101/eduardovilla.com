---
// Cambio de idioma ES/EN. Calcula la ruta equivalente a partir de la actual.
interface Props {
  lang: "es" | "en";
}
const { lang } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isEn = path === "/en" || path.startsWith("/en/");
const bare = isEn ? path.replace(/^\/en/, "") || "/" : path;
const esHref = bare === "/" ? "/" : bare;
const enHref = bare === "/" ? "/en" : `/en${bare}`;
const current = isEn ? "en" : "es";
---
<div class="flex items-center gap-0.5 rounded-full border border-line p-0.5 text-xs font-semibold" aria-label="Idioma">
  <a
    href={esHref}
    class:list={["rounded-full px-2.5 py-1 transition-colors", current === "es" ? "bg-accent text-[var(--accent-ink)]" : "text-[var(--ink-faint)] hover:text-[var(--ink)]"]}
    aria-current={current === "es" ? "true" : undefined}
  >ES</a>
  <a
    href={enHref}
    class:list={["rounded-full px-2.5 py-1 transition-colors", current === "en" ? "bg-accent text-[var(--accent-ink)]" : "text-[var(--ink-faint)] hover:text-[var(--ink)]"]}
    aria-current={current === "en" ? "true" : undefined}
  >EN</a>
</div>
