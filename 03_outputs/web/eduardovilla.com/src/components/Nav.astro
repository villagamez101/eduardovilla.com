---
import { t, getLang } from "@i18n/ui";
import Logo from "@components/Logo.astro";
import ThemeSwitch from "@components/ThemeSwitch.astro";
import LanguageSwitch from "@components/LanguageSwitch.astro";

interface Props {
  lang: "es" | "en";
}
const { lang } = Astro.props;
const l = getLang(lang);
const base = lang === "en" ? "/en" : "";

const items = [
  { href: `${base}/`, label: t.nav.inicio },
  { href: `${base}/acerca`, label: t.nav.acerca },
  { href: `${base}/areas`, label: t.nav.areas },
  { href: `${base}/proyectos`, label: t.nav.proyectos },
  { href: `${base}/blog`, label: t.nav.blog },
  { href: `${base}/contacto`, label: t.nav.contacto },
];

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const home = href.endsWith("/");
  const h = href.replace(/\/+$/, "") || "/";
  const p = path.replace(/\/+$/, "") || "/";
  if (home) return p === h;
  return p === h || p.startsWith(`${h}/`);
};
---
<header class="site-header sticky top-0 z-50">
  <div class="glass border-x-0 border-t-0 px-[var(--gutter)]">
    <div class="mx-auto flex w-full max-w-[var(--max-w)] items-center justify-between gap-4 py-3">
      <div class="flex items-center gap-4">
        <a href={`${base}/`} class="logo flex items-center gap-2.5" aria-label="Eduardo Villa — inicio">
          <Logo class="h-9 w-9" />
          <span class="text-sm font-bold tracking-tight">Eduardo Villa</span>
        </a>
        <span class="hidden items-center gap-2 border-l border-[var(--line)] pl-4 text-xs ink-faint lg:flex">
          <span class="status-dot" aria-hidden="true"></span>
          {t.footer.disponible[l]}
        </span>
      </div>

      <nav class="hidden items-center gap-0 lg:flex" aria-label="Principal">
        {items.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "nav-link relative rounded-full px-2 py-1.5 text-[0.8rem] transition-colors",
              isActive(item.href)
                ? "text-[var(--accent-text)]"
                : "text-[var(--ink-soft)] hover:text-[var(--ink)]",
            ]}
          >
            {item.label[l]}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <div class="hidden lg:block">
          <LanguageSwitch lang={lang} />
        </div>
        <ThemeSwitch />
        <button
          id="nav-toggle"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-line text-[var(--ink)] transition-colors hover:border-[var(--accent)] lg:hidden"
          aria-expanded="false"
          aria-controls="nav-mobile"
          aria-label={lang === "es" ? "Menú" : "Menu"}
        >
          <svg class="nav-toggle__icon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <line class="nav-toggle__top" x1="4" y1="9" x2="20" y2="9" />
            <line class="nav-toggle__bottom" x1="4" y1="15" x2="20" y2="15" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="nav-mobile" class="site-menu glass border-x-0 lg:hidden">
    <div class="mx-auto w-full max-w-[var(--max-w)] px-[var(--gutter)] pb-7 pt-5">
      <p class="flex items-center gap-2.5 text-xs ink-faint">
        <span class="status-dot" aria-hidden="true"></span>
        {t.footer.disponible[l]}
      </p>

      <nav class="mt-4" aria-label={lang === "es" ? "Menú principal" : "Main menu"}>
        <ul class="border-t border-[var(--line)]">
          {items.map((item) => (
            <li class="border-b border-[var(--line)]">
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "group/item flex items-center justify-between gap-4 py-4 text-base transition-colors",
                  isActive(item.href)
                    ? "text-[var(--accent-text)]"
                    : "text-[var(--ink-soft)] active:text-[var(--ink)]",
                ]}
              >
                <span>{item.label[l]}</span>
                <svg
                  class:list={[
                    "h-4 w-4 flex-none transition-transform group-hover/item:translate-x-1",
                    isActive(item.href) ? "text-[var(--accent-text)]" : "text-[var(--ink-faint)]",
                  ]}
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mt-6 flex items-center justify-between gap-4">
        <span class="label">{lang === "es" ? "Idioma" : "Language"}</span>
        <LanguageSwitch lang={lang} />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );
</script>
