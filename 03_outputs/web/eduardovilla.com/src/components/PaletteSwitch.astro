---
// Selector de paleta A/B/C — pensado para explorar, luego se fija una.
const palettes = [
  { id: "a", label: "A" },
  { id: "b", label: "B" },
  { id: "c", label: "C" },
];
---
<div
  id="palette-switch"
  class="fixed bottom-4 right-4 z-50 flex items-center gap-1 rounded-full border rule p-1"
  style="background: var(--bg-elev);"
  role="group"
  aria-label="Paleta de color"
  data-explorer
>
  {palettes.map((p) => (
    <button
      data-palette-btn={p.id}
      class="flex h-7 w-7 items-center justify-center rounded-full text-xs transition-opacity"
      style="background: var(--bg); color: var(--ink-soft);"
      aria-label={`Paleta ${p.label}`}
      title={`Paleta ${p.label}`}
    >
      {p.label}
    </button>
  ))}
</div>

<script>
  const wrap = document.getElementById("palette-switch");
  const buttons = wrap?.querySelectorAll("[data-palette-btn]") ?? [];
  const paint = () => {
    const cur = document.documentElement.dataset.palette || "a";
    buttons.forEach((b) => {
      const active = (b as HTMLElement).dataset.paletteBtn === cur;
      (b as HTMLElement).style.color = active ? "var(--accent)" : "var(--ink-faint)";
    });
  };
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const id = (b as HTMLElement).dataset.paletteBtn;
      document.documentElement.dataset.palette = id;
      localStorage.setItem("ev-palette", String(id));
      paint();
    })
  );
  paint();
</script>
