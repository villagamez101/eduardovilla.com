---
/**
 * Tarjeta de proyecto.
 *
 * Si el proyecto trae `miniatura`, se muestra la pieza principal tal cual
 * (logotipo o tarjeta) centrada sobre un fondo claro, sin recorte: es la
 * miniatura estandarizada de la retícula. Si no, cae al `cover` con marco.
 */
import Media from "@components/Media.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  areaLabel: string;
  year?: string;
  cover?: string;
  coverAlt?: string;
  coverRatio?: string;
  miniatura?: string;
  miniaturaRatio?: string;
  index?: string;
  placeholder?: string;
  delay?: number;
}

const {
  href,
  title,
  description,
  areaLabel,
  year,
  cover,
  coverAlt = "",
  coverRatio = "4 / 3",
  miniatura,
  miniaturaRatio = "16 / 10",
  index,
  placeholder,
  delay = 0,
} = Astro.props;
---

<a
  href={href}
  class="card project-card reveal group"
  style={`--d:${Math.min(delay, 300)}ms`}
>
  {miniatura ? (
    <div class="project-card__thumb" style={`aspect-ratio: ${miniaturaRatio}`}>
      <img
        class="project-card__thumb-img"
        src={miniatura}
        alt={coverAlt || title}
        loading="lazy"
        decoding="async"
        draggable="false"
        oncontextmenu="return false"
      />
    </div>
  ) : (
    <Media
      class="project-card__media"
      src={cover}
      alt={coverAlt}
      ratio={coverRatio}
      index={index}
      placeholder={placeholder}
    />
  )}

  <div class="project-card__body">
    <div class="project-card__meta">
      <span class="label">{areaLabel}</span>
      {year && <span class="label tabular-nums">{year}</span>}
    </div>
    <h3 class="display-3 project-card__title">{title}</h3>
    <p class="project-card__desc">{description}</p>
  </div>
</a>
