---
import Base from "@layouts/Base.astro";
---
<Base lang="es" title="404 — Eduardo Villa" description="Página no encontrada.">
  <section class="flex min-h-[70vh] flex-col items-center justify-center gap-4 text-center">
    <p class="font-extrabold leading-none grad-text" style="font-size: clamp(5rem, 20vw, 12rem);">404</p>
    <h1 class="font-bold" style="font-size: var(--fs-h2);">Esta página no existe.</h1>
    <p class="ink-soft">Pero la de inicio sí.</p>
    <a href="/" class="btn btn-accent mt-2">Volver a Inicio →</a>
  </section>
</Base>
