---
import Base from "@layouts/Base.astro";
import { t, getLang } from "@i18n/ui";
import areas from "@data/areas.json";

const l = getLang("es");
const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
---
<Base
  lang="es"
  title={`${t.areas.indexTitle.es} — Eduardo Villa`}
  description="Las seis áreas de Eduardo Villa: seis lentes sobre el mismo problema — estructura digital para negocios y para la vida."
>
  <section class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.areas.indexTitle.es}</p>
    <h1 class="mt-3 font-semibold" style="font-size: var(--fs-h2);">
      Seis lentes, un mismo problema
    </h1>
    <ol class="mt-10 divide-y rule border-y rule">
      {ordenadas.map((a) => (
        <li>
          <a href={`/areas/${a.slug}`} class="group grid gap-2 py-6 md:grid-cols-[3rem_1fr] md:items-baseline">
            <span class="text-[var(--ink-faint)] group-hover:text-[var(--accent)] transition-colors" aria-hidden="true">{a.icono}</span>
            <span>
              <span class="font-semibold group-hover:text-[var(--accent)] transition-colors">{a.titulo.es}</span>
              <span class="mt-1 block max-w-[38rem] text-sm text-[var(--ink-soft)]">{a.lema.es}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
