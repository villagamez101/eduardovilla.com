---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
---
<Base
  lang="es"
  title={`${t.areas.indexTitle.es} — Eduardo Villa`}
  description="Las seis áreas de Eduardo Villa: seis lentes sobre el mismo problema — estructura digital para negocios y para la vida."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">Seis lentes, un mismo problema</h1>
    <p class="rise-2 mt-6 measure ink-soft">
      No son categorías de servicios: son formas de mirar. Cada área se cruza con las demás.
    </p>
  </section>

  <ol class="mt-14 border-t border-[var(--line)]">
    {ordenadas.map((a, i) => (
      <li class="border-b border-[var(--line)]">
        <a
          href={`/areas/${a.slug}`}
          class="reveal group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-5 gap-y-2 py-8 sm:grid-cols-[3rem_16rem_1fr_auto]"
          style={`--d:${Math.min(i * 55, 280)}ms`}
        >
          <span class="label tabular-nums">{String(i + 1).padStart(2, "0")}</span>
          <h2 class="display-3 transition-colors group-hover:text-[var(--accent-text)]">{a.titulo.es}</h2>
          <p class="col-span-3 text-sm ink-soft sm:col-span-1 sm:text-[0.95rem]">{a.lema.es}</p>
          <span class="ink-faint transition-all group-hover:translate-x-1 group-hover:text-[var(--accent-text)]" aria-hidden="true">→</span>
          {a.mision && <span class="label col-span-3 text-[var(--accent-text)] sm:col-span-1 sm:col-start-2">La misión</span>}
        </a>
      </li>
    ))}
  </ol>
</Base>
