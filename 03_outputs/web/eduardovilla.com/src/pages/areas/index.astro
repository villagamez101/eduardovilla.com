---
import Base from "@layouts/Base.astro";
import AreaCard from "@components/AreaCard.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
---
<Base
  lang="es"
  title={`${t.areas.indexTitle.es} — Eduardo Villa`}
  description="Las seis áreas de interés de Eduardo Villa: diseño gráfico, branding, desarrollo web, marketing digital, comercio electrónico e inteligencia artificial."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">{t.home.areasTitle.es}</h1>
    <p class="rise-2 mt-6 measure ink-soft">
      No son categorías de servicios: son intereses que se cruzan. Un negocio desordenado necesita visión integral, no piezas sueltas.
    </p>
  </section>

  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {ordenadas.map((a, i) => (
      <AreaCard
        href={`/areas/${a.slug}`}
        slug={a.slug}
        num={String(i + 1).padStart(2, "0")}
        title={a.titulo.es}
        lema={a.lema.es}
        more={t.home.leerMas.es}
        delay={i * 55}
      />
    ))}
  </div>
</Base>
