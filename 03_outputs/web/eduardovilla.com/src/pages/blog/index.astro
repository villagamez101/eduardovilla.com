---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
---
<Base
  lang="es"
  title={`${t.blog.indexTitle.es} — Eduardo Villa`}
  description="Escritos de Eduardo Villa: aprendizajes, procesos y notas sobre sistemas, diseño y minimalismo."
>
  <section class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.blog.indexTitle.es}</p>
    <h1 class="mt-3 font-semibold" style="font-size: var(--fs-h2);">
      Notas del recorrido.
    </h1>
    <p class="mt-4 max-w-[34rem] text-[var(--ink-soft)]">
      {t.blog.vacio.es} — la collection ya está armada; los primeros ensayos entran
      cuando el contenido esté listo.
    </p>
    <div class="mt-12 divide-y rule border-y rule" aria-hidden="true">
      {Array.from({ length: 3 }).map((_, i) => (
        <article class="grid gap-1 py-6 md:grid-cols-[8rem_1fr] md:items-baseline">
          <p class="kicker">Próximo</p>
          <p class="font-semibold">Lorem ipsum: título del ensayo {i + 1}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
