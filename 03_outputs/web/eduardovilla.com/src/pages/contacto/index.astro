---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import contacto from "@data/contacto.json";

const canales = [
  { k: "Email", v: contacto.email, href: `mailto:${contacto.email}` },
  { k: "Teléfono", v: contacto.telefono, href: `tel:${contacto.telefono.replace(/\s/g, "")}` },
  { k: "WhatsApp", v: "Abrir chat", href: `https://wa.me/${contacto.whatsapp}` },
  { k: "Dónde", v: contacto.ubicacion, href: null },
];
---
<Base
  lang="es"
  title="Contacto — Eduardo Villa"
  description="Escríbeme: email, teléfono o WhatsApp. La puerta está abierta."
>
  <section class="py-16">
    <p class="kicker rise">Contacto</p>
    <h1 class="rise-2 mt-4 font-extrabold leading-[0.95] tracking-tight" style="font-size: var(--fs-display);">
      Hablemos<span class="text-[var(--accent)]">.</span>
    </h1>
    <p class="rise-3 mt-6 max-w-[34rem] leading-relaxed ink-soft">{t.contacto.saludo.es}</p>

    <div class="reveal mt-12 grid max-w-[38rem] gap-3">
      {canales.map((c) => (
        <div class="card flex items-center justify-between gap-4 p-5">
          <span class="kicker">{c.k}</span>
          {c.href ? (
            <a class="link-accent font-semibold" href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined}>{c.v}</a>
          ) : (
            <span class="font-semibold">{c.v}</span>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
