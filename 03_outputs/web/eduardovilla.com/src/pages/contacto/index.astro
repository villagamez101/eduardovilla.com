---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import contacto from "@data/contacto.json";
---
<Base
  lang="es"
  title={`Contacto — Eduardo Villa`}
  description="Escríbeme: email, teléfono o WhatsApp. La puerta está abierta."
>
  <section class="py-[calc(var(--space-unit)*3)]">
    <p class="kicker">Contacto</p>
    <h1 class="mt-3 font-semibold" style="font-size: var(--fs-display);">
      Hablemos<span class="text-[var(--accent)]">.</span>
    </h1>
    <p class="mt-6 max-w-[34rem] leading-relaxed text-[var(--ink-soft)]">
      {t.contacto.saludo.es}
    </p>
    <div class="mt-10 grid max-w-[34rem] gap-4 border-t rule pt-8 text-sm">
      <div class="flex items-baseline justify-between gap-4">
        <span class="kicker">Email</span>
        <a class="a-link" href={`mailto:${contacto.email}`}>{contacto.email}</a>
      </div>
      <div class="flex items-baseline justify-between gap-4 border-t rule pt-4">
        <span class="kicker">Teléfono</span>
        <a class="a-link" href={`tel:${contacto.telefono.replace(/\s/g, "")}`}>{contacto.telefono}</a>
      </div>
      <div class="flex items-baseline justify-between gap-4 border-t rule pt-4">
        <span class="kicker">WhatsApp</span>
        <a class="a-link" href={`https://wa.me/${contacto.whatsapp}`}>Abrir chat</a>
      </div>
      <div class="flex items-baseline justify-between gap-4 border-t rule pt-4">
        <span class="kicker">Dónde</span>
        <span>{contacto.ubicacion}</span>
      </div>
    </div>
  </section>
</Base>
