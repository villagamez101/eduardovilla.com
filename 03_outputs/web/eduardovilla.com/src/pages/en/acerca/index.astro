---
import Base from "@layouts/Base.astro";
import SocialLinks from "@components/SocialLinks.astro";
import { t } from "@i18n/ui";
import contacto from "@data/contacto.json";

const trajectory = [
  {
    k: "2022–2026",
    t: "Project manager",
    org: "Linkbits",
    d: "Custom ERP in production in under six months · Lark Suite for 800+ users · functional analysis, QA, documentation and training.",
  },
  {
    k: "2019–2022",
    t: "E-commerce lead",
    org: "Linkbits",
    d: "Built the operation from scratch to $5M MXN a month · 20+ marketplaces · 3,000-product catalog · team of 6.",
  },
  {
    k: "2018–2019",
    t: "Graphic designer",
    org: "Sisco Tecnología",
    d: "Advertising pieces, product photography and social content. Where it all started.",
  },
];

const strengths = [
  { n: "Integral vision", v: 95 },
  { n: "Problem solving", v: 92 },
  { n: "Self-taught learning", v: 95 },
  { n: "Analytical thinking", v: 90 },
  { n: "Organization & follow-through", v: 88 },
  { n: "Creative approach", v: 86 },
];

const tools = [
  "Advanced Excel",
  "Lark Suite · Notion",
  "ERP systems",
  "Amazon · Mercado Libre",
  "WordPress · WooCommerce",
  "Figma · Photoshop · Illustrator",
];
---
<Base
  lang="en"
  title={`${t.acerca.indexTitle.en} — Eduardo Villa`}
  description="Eduardo Villa: process and systems analyst, creative generalist. His story, where he's at now, his career, his education and his strengths."
>
  <article class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display rise">Hi, I'm Eduardo<span class="text-[var(--accent-text)]">.</span></h1>

    <div class="rise-2 mt-8 measure space-y-5 lede ink-soft">
      <p>
        I've spent more than 7 years working in digital transformation, bringing
        together areas that almost always stay apart: technology, design, marketing
        and processes.
      </p>
      <p>
        Along the way I learned that a company's problems are rarely technical.
        They're disorder, resistance to change, weak administration and a lack of
        digitization.
      </p>
      <p>
        That's why I don't sell loose pieces: I integrate systems and tools that
        connect to each other and go straight at the most critical part of the
        business.
      </p>
      <p>
        Measurable results and goals aimed at generating business: no bullshit. And
        always from the root, because your company needs strong foundations to
        withstand growth.
      </p>
    </div>

    <!-- Now -->
    <section class="mt-20 grid gap-6 border-t border-[var(--line)] pt-14 lg:grid-cols-[10rem_1fr] lg:gap-10">
      <span class="label reveal lg:pt-2">Now</span>
      <div class="reveal">
        <p class="label tabular-nums">2026 — present</p>
        <p class="mt-3 font-semibold">
          Project management <span class="ink-faint">· Construrama Marego</span>
        </p>
        <p class="mt-4 measure">
          I lead the main digital growth projects for this company in construction
          materials, hardware and structural steel.
        </p>
        <p class="mt-4 measure ink-soft">
          And I'm learning artificial intelligence and digital projects with agents.
        </p>
      </div>
    </section>

    <!-- Trajectory -->
    <section class="mt-20">
      <p class="label reveal border-t border-[var(--line)] pt-3">Trajectory</p>
      <ol class="mt-6">
        {trajectory.map((h, i) => (
          <li class="reveal grid gap-1 border-b border-[var(--line)] py-6 sm:grid-cols-[9rem_1fr] sm:gap-8" style={`--d:${i * 70}ms`}>
            <span class="label tabular-nums sm:pt-1">{h.k}</span>
            <span>
              <span class="block font-semibold">{h.t} <span class="ink-faint">· {h.org}</span></span>
              <span class="mt-1 block text-sm ink-soft">{h.d}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Education and self-taught -->
    <section class="mt-20 grid gap-12 border-t border-[var(--line)] pt-14 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <p class="label">Education</p>
        <p class="mt-4 measure">
          <span class="block font-semibold">Systems Engineering — 4th semester</span>
          <span class="mt-1 block text-sm ink-soft">
            Instituto Tecnológico de Orizaba · Tecnológico de Huatusco. The degree was
            left unfinished; the urge to learn wasn't.
          </span>
        </p>
      </div>
      <div class="reveal" style="--d:110ms">
        <p class="label">Self-taught knowledge</p>
        <p class="mt-4 measure text-sm ink-soft">
          Much of what I know didn't come from a classroom: it came from real projects,
          from getting it wrong in production and from learning out of pure curiosity
          —design, web development, process automation, data analysis and AI. That is,
          perhaps, my best credential.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {tools.map((h) => (
            <li class="tag">{h}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Strengths -->
    <section class="mt-20 border-t border-[var(--line)] pt-14">
      <p class="label reveal">Strengths</p>
      <div class="mt-8 grid gap-x-14 gap-y-7 sm:grid-cols-2">
        {strengths.map((s, i) => (
          <div class="skill reveal" style={`--d:${i * 70}ms; --v:${s.v}%`}>
            <div class="skill__top">
              <span class="skill__name">{s.n}</span>
              <span class="skill__val label">{s.v}</span>
            </div>
            <div class="skill__track" role="img" aria-label={`${s.n}: ${s.v} out of 100`}>
              <span class="skill__fill"></span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Close -->
    <section class="mt-24 border-t border-[var(--line)] pt-16 pb-8">
      <p class="display-2 reveal measure">Does any of this resonate?</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/cv-eduardo-villa-2026.pdf" target="_blank" rel="noopener" class="btn btn-accent rise">
          View CV <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href="/cv-eduardo-villa-2026.pdf" download class="btn rise-2">Download CV</a>
      </div>
      <p class="mt-6 text-sm">
        <a class="a-link" href="/en/contacto">Rather write to me? Let's talk →</a>
      </p>
      <div class="reveal mt-8">
        <SocialLinks x={contacto.x} github={contacto.github} instagram={contacto.instagram} linkedin={contacto.linkedin} behance={contacto.behance} />
      </div>
    </section>
  </article>
</Base>
