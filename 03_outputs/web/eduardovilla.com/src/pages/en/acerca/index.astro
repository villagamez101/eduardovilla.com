---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
---
<Base
  lang="en"
  title={`${t.acerca.indexTitle.en} — Eduardo Villa`}
  description="Who Eduardo Villa is: creative generalist, process and systems analyst, and why this site exists."
>
  <article class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.acerca.indexTitle.en}</p>
    <h1 class="mt-3 max-w-[40rem] font-semibold leading-tight" style="font-size: var(--fs-h2);">
      I do few things, but I do them fully.
    </h1>

    <div class="mt-10 max-w-[38rem] space-y-5 leading-relaxed">
      <p>
        I'm Eduardo Villa, from Córdoba, Veracruz (Mexico). I started out designing
        (Sisco, 2018), ended up running e-commerce (three years, twenty marketplaces,
        three thousand products) and settled where design and systems meet:
        technology applied with judgment to real businesses.
      </p>
      <p>
        At Linkbits — seven years — I built catalogs and stores, then managed
        projects: a custom ERP in production in under six months, Lark Suite for
        800+ users. Along the way I learned almost no problem is "a design problem"
        or "a systems problem": it's the whole picture.
      </p>
      <p>
        This site is my refuge: a place to write what I learn, keep what I build
        and show the full path of a generalist — without the polished showcase
        you'd expect from a portfolio.
      </p>
    </div>

    <section class="mt-14 border-t rule pt-8">
      <p class="kicker">Now</p>
      <p class="mt-3 max-w-[34rem] text-sm text-[var(--ink-soft)]">
        Exploring AI applied to real operations, building this site and making room
        to write. Updated: 2026.
      </p>
    </section>
  </article>
</Base>
