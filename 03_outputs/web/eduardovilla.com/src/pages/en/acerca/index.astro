---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";

const milestones = [
  { k: "2022–2026", t: "Project manager", d: "Custom ERP in production in under 6 months · Lark Suite for 800+ users." },
  { k: "2019–2022", t: "E-commerce lead", d: "~$5M MXN/month · 20+ marketplaces · 3,000-product catalog · team of 6." },
  { k: "2018–2019", t: "Graphic designer", d: "Where it all started: identity, form and color." },
];
---
<Base
  lang="en"
  title={`${t.acerca.indexTitle.en} — Eduardo Villa`}
  description="Who Eduardo Villa is: creative generalist, process and systems analyst, and why this site exists."
>
  <article class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">
      I do few things,<br />but I do them fully.
    </h1>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.7fr_1fr]">
      <div class="reveal space-y-6 lede">
        <p>
          I'm Eduardo Villa, from Córdoba, Veracruz (Mexico). I started out designing,
          ended up running e-commerce (three years, twenty marketplaces, three thousand
          products) and settled where design and systems meet: technology applied with
          judgment to real businesses.
        </p>
        <p class="ink-soft">
          At Linkbits — seven years — I built catalogs and stores, then managed
          projects: a custom ERP in production in under six months, Lark Suite for
          800+ users. I learned almost no problem is "a design problem" or "a systems
          problem": it's the whole picture.
        </p>
        <p class="ink-soft">
          This site is my refuge: a place to write what I learn, keep what I build and
          show the full path of a generalist.
        </p>
      </div>

      <aside class="reveal flex flex-col gap-8">
        <div>
          <p class="label border-t border-[var(--line)] pt-3">Now</p>
          <p class="mt-3 text-sm ink-soft">
            Exploring AI applied to real operations, building this site and making room
            to write. Updated: 2026.
          </p>
        </div>
        <a href="/en/contacto" class="btn btn-accent w-fit">Let's talk →</a>
      </aside>
    </div>

    <section class="mt-20">
      <p class="label reveal border-t border-[var(--line)] pt-3">Trajectory</p>
      <ol class="mt-6">
        {milestones.map((h, i) => (
          <li class="reveal grid gap-1 border-b border-[var(--line)] py-6 sm:grid-cols-[10rem_1fr] sm:gap-8" style={`--d:${i * 70}ms`}>
            <span class="label tabular-nums sm:pt-1">{h.k}</span>
            <span>
              <span class="block font-semibold">{h.t}</span>
              <span class="mt-1 block text-sm ink-soft">{h.d}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-sm">
        <a class="a-link" href="/en/recursos">Full 2026 CV and resources →</a>
      </p>
    </section>
  </article>
</Base>
