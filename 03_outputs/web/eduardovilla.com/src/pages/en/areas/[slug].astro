---
import Base from "@layouts/Base.astro";
import CarruselProyectos from "@components/CarruselProyectos.astro";
import { getCollection } from "astro:content";
import { t, getLang } from "@i18n/ui";
import { proyectoSlug } from "@/lib/proyectos";
import areas from "@data/areas.json";

export async function getStaticPaths() {
  return areas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const l = getLang("en");
const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
const pos = ordenadas.findIndex((x) => x.slug === area.slug) + 1;
const relacionadas = areas.filter((x) => x.slug !== area.slug).slice(0, 3);
const proyectos = (
  await getCollection(
    "proyectos",
    ({ data }) =>
      data.lang === "en" &&
      !data.draft &&
      (data.area === area.slug || data.areaSecundaria === area.slug)
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  lang="en"
  title={`${area.titulo[l]} — Eduardo Villa`}
  description={area.resumen[l].slice(0, 155)}
>
  <article class="mt-14 border-t border-[var(--line)] pt-12">
    <a href="/en/areas" class="link-accent text-sm">{t.areas.back[l]}</a>

    <header class="mt-10 grid gap-4 sm:grid-cols-[auto_1fr] sm:items-start sm:gap-10">
      <span class="display-page rise text-[var(--ink-faint)]" aria-hidden="true">{String(pos).padStart(2, "0")}</span>
      <div>
        <h1 class="display-page rise-2">
          {area.titulo[l]}
        </h1>
        <p class="rise-3 mt-6 measure lede ink-soft">{area.lema[l]}</p>
      </div>
    </header>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.7fr_1fr]">
      <div class="reveal space-y-8">
        <p class="lede">{area.resumen[l]}</p>
      </div>

      <aside class="reveal flex flex-col gap-10">
        <div>
          <p class="label border-t border-[var(--line)] pt-3">Crosses with</p>
          <ul class="mt-4 flex flex-col">
            {relacionadas.map((r) => (
              <li class="border-b border-[var(--line)]">
                <a href={`/en/areas/${r.slug}`} class="group flex items-baseline justify-between gap-3 py-3 text-sm">
                  <span class="transition-colors group-hover:text-[var(--accent-text)]">{r.titulo[l]}</span>
                  <span class="ink-faint transition-all group-hover:translate-x-1 group-hover:text-[var(--accent-text)]" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    {proyectos.length > 0 && (
      <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="area-proyectos">
        <div class="flex items-end justify-between gap-4">
          <h2 id="area-proyectos" class="display-2 reveal">{t.areas.enEstaArea.en}</h2>
          <a href="/en/proyectos" class="link-accent hidden text-sm sm:inline">{t.home.verTodos.en} →</a>
        </div>
        <CarruselProyectos
          proyectos={proyectos}
          lang="en"
          areaLabel={area.titulo.en}
          placeholder={t.home.imgPlaceholder.en}
        />
      </section>
    )}
  </article>
</Base>
