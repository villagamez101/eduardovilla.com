---
import Base from "@layouts/Base.astro";
import { t, getLang } from "@i18n/ui";
import areas from "@data/areas.json";

export async function getStaticPaths() {
  return areas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const l = getLang("en");
const base = "/en";
const relacionadas = areas.filter((x) => x.slug !== area.slug).slice(0, 3);
---
<Base
  lang="en"
  title={`${area.titulo[l]} — Eduardo Villa`}
  description={area.resumen[l].slice(0, 155)}
>
  <article class="py-16">
    <a href="/en/areas" class="link-accent text-sm">{t.areas.back[l]}</a>

    <header class="mt-8 flex flex-col gap-5">
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl text-2xl text-[var(--accent)] rise" style="background: var(--accent-soft);" aria-hidden="true">{area.icono}</span>
      <p class="kicker rise-2">Area {area.orden}{area.mision ? " — the mission" : ""}</p>
      <h1 class="rise-2 max-w-[42rem] font-extrabold leading-[0.98] tracking-tight" style="font-size: var(--fs-h2);">
        {area.titulo[l]}
      </h1>
      <p class="rise-3 max-w-[36rem] text-lg ink-soft">{area.lema[l]}</p>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div class="reveal space-y-6 leading-relaxed">
        <p class="text-[var(--fs-lede)]">{area.resumen[l]}</p>
        {"conector" in area && area.conector && (
          <blockquote class="border-l-2 pl-5 ink-soft" style="border-color: var(--accent);">
            {area.conector[l]}
          </blockquote>
        )}
      </div>

      <aside class="reveal flex flex-col gap-4">
        <div class="card p-6">
          <p class="kicker">In this area</p>
          <p class="mt-3 text-sm ink-soft">Real projects and writings arrive once the content is ready — placeholder for now.</p>
        </div>
        <div class="card p-6">
          <p class="kicker">Crosses with</p>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {relacionadas.map((r) => (
              <li>
                <a href={`${base}/areas/${r.slug}`} class="group flex items-center gap-2 text-[var(--ink-soft)] transition-colors hover:text-[var(--accent)]">
                  <span class="text-[var(--accent)]" aria-hidden="true">{r.icono}</span>
                  {r.titulo[l]}
                  <span class="ml-auto transition-transform group-hover:translate-x-0.5">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </article>
</Base>
