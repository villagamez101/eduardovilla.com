---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

export async function getStaticPaths() {
  return areas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}

const { area } = Astro.props;
const l: "es" | "en" = "en";
const related = areas.filter((x) => x.slug !== area.slug).slice(0, 3);
---
<Base
  lang={l}
  title={`${area.titulo[l]} — Eduardo Villa`}
  description={area.resumen[l].slice(0, 155)}
>
  <article class="py-[calc(var(--space-unit)*2)]">
    <a href="/en/areas" class="a-link text-sm">{t.areas.back[l]}</a>
    <header class="mt-6">
      <p class="kicker">
        Area {area.orden}{area.mision ? " — the mission" : ""}
      </p>
      <h1 class="mt-3 flex items-baseline gap-4 font-semibold" style="font-size: var(--fs-h2);">
        <span class="text-[var(--accent)]" aria-hidden="true">{area.icono}</span>
        {area.titulo[l]}
      </h1>
      <p class="mt-4 text-lg text-[var(--ink-soft)]">{area.lema[l]}</p>
    </header>

    <div class="mt-10 max-w-[38rem] space-y-5 leading-relaxed">
      <p>{area.resumen[l]}</p>
      {"conector" in area && area.conector && (
        <p class="border-l-2 pl-4 text-[var(--ink-soft)]" style="border-color: var(--accent);">
          {area.conector[l]}
        </p>
      )}
    </div>

    <section class="mt-16 border-t rule pt-8">
      <p class="kicker">Other areas that cross it</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {related.map((r) => (
          <li>
            <a href={`/en/areas/${r.slug}`} class="a-link text-sm">
              <span class="text-[var(--ink-faint)] mr-1" aria-hidden="true">{r.icono}</span>{r.titulo[l]}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10 text-sm text-[var(--ink-faint)]">
      <p class="kicker mb-3">In this area</p>
      <p>Projects and writings will arrive with the real content — placeholder for now.</p>
    </section>
  </article>
</Base>
