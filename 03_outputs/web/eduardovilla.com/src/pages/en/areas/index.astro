---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

const l = "en" as const;
const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
---
<Base
  lang="en"
  title={`${t.areas.indexTitle.en} — Eduardo Villa`}
  description="Eduardo Villa's six areas: six lenses on the same problem — digital structure for businesses and for life."
>
  <section class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.areas.indexTitle.en}</p>
    <h1 class="mt-3 font-semibold" style="font-size: var(--fs-h2);">
      Six lenses, one problem
    </h1>
    <ol class="mt-10 divide-y rule border-y rule">
      {ordenadas.map((a) => (
        <li>
          <a href={`/en/areas/${a.slug}`} class="group grid gap-2 py-6 md:grid-cols-[3rem_1fr] md:items-baseline">
            <span class="text-[var(--ink-faint)] group-hover:text-[var(--accent)] transition-colors" aria-hidden="true">{a.icono}</span>
            <span>
              <span class="font-semibold group-hover:text-[var(--accent)] transition-colors">{a.titulo.en}</span>
              <span class="mt-1 block max-w-[38rem] text-sm text-[var(--ink-soft)]">{a.lema.en}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
