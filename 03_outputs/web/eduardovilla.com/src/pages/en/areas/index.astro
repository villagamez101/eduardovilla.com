---
import Base from "@layouts/Base.astro";
import AreaCard from "@components/AreaCard.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
---
<Base
  lang="en"
  title={`${t.areas.indexTitle.en} — Eduardo Villa`}
  description="Eduardo Villa's six areas of interest: graphic design, branding, web development, digital marketing, e-commerce and artificial intelligence."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">{t.home.areasTitle.en}</h1>
    <p class="rise-2 mt-6 measure ink-soft">
      They aren't service categories: they're interests that cross. A messy business needs integral vision, not loose pieces.
    </p>
  </section>

  <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {ordenadas.map((a, i) => (
      <AreaCard
        href={`/en/areas/${a.slug}`}
        slug={a.slug}
        num={String(i + 1).padStart(2, "0")}
        title={a.titulo.en}
        lema={a.lema.en}
        more={t.home.leerMas.en}
        delay={i * 55}
      />
    ))}
  </div>
</Base>
