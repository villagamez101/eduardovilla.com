---
import Base from "@layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.lang === "en" && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug || post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base lang="en" title={`${post.data.title} — Eduardo Villa`} description={post.data.description}>
  <article class="mt-14 border-t border-[var(--line)] pt-12">
    <a href="/en/blog" class="link-accent text-sm">← Blog</a>
    <header class="mt-10">
      <h1 class="display-2 rise measure">{post.data.title}</h1>
      <p class="rise-2 mt-6 measure lede ink-soft">{post.data.description}</p>
      <div class="mt-6 border-t border-[var(--line)] pt-3">
        <time class="label tabular-nums" datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </div>
    </header>
    <div class="reveal prose-custom mt-12 measure">
      <Content />
    </div>
  </article>
</Base>
