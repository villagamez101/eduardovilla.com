---
import Base from "@layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.lang === "en" && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug || post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base lang="en" title={`${post.data.title} — Eduardo Villa`} description={post.data.description}>
  <article class="py-16">
    <a href="/en/blog" class="link-accent text-sm">← Blog</a>
    <header class="mt-8">
      <time class="kicker" datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </time>
      <h1 class="mt-3 max-w-[40rem] font-extrabold leading-[1.02] tracking-tight" style="font-size: var(--fs-h2);">
        {post.data.title}
      </h1>
      <p class="mt-4 max-w-[36rem] text-lg ink-soft">{post.data.description}</p>
    </header>
    <div class="reveal prose-custom mt-10 max-w-[42rem] leading-relaxed">
      <Content />
    </div>
  </article>
</Base>
