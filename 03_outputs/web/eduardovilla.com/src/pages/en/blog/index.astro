---
import Base from "@layouts/Base.astro";
import { getCollection } from "astro:content";
import { t } from "@i18n/ui";

const posts = (await getCollection("blog", ({ data }) => data.lang === "en" && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  lang="en"
  title={`${t.blog.indexTitle.en} — Eduardo Villa`}
  description="Eduardo Villa's writings: lessons, processes and notes on systems, design and minimalism."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">Notes along the way.</h1>
    <p class="rise-2 mt-6 measure ink-soft">
      Lessons, processes and what breaks along the way.
    </p>
  </section>

  <section class="mt-14">
    {posts.length === 0 && (
      <p class="border-t border-[var(--line)] pt-6 text-sm ink-soft">{t.blog.vacio.en}</p>
    )}
    <ul class="border-t border-[var(--line)]">
      {posts.map((post, i) => (
        <li class="border-b border-[var(--line)]">
          <a
            href={`/en/blog/${post.data.slug || post.id.replace(/\.md$/, "")}/`}
            class="reveal group grid gap-2 py-6 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8"
            style={`--d:${Math.min(i * 60, 240)}ms`}
          >
            <span>
              <span class="display-3 block transition-colors group-hover:text-[var(--accent-text)]">{post.data.title}</span>
              <span class="measure mt-2 block text-sm ink-soft">{post.data.description}</span>
            </span>
            <time class="label tabular-nums" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long" })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
