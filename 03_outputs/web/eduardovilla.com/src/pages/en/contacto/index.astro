---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import contacto from "@data/contacto.json";

const channels = [
  { k: "Email", v: contacto.email, href: `mailto:${contacto.email}` },
  { k: "Phone", v: contacto.telefono, href: `tel:${contacto.telefono.replace(/\s/g, "")}` },
  { k: "WhatsApp", v: "Open chat", href: `https://wa.me/${contacto.whatsapp}` },
  { k: "Where", v: "Córdoba, Veracruz — MX", href: null },
];
---
<Base
  lang="en"
  title="Contact — Eduardo Villa"
  description="Write to me: email, phone or WhatsApp. The door is open."
>
  <section class="py-16">
    <p class="kicker rise">Contact</p>
    <h1 class="rise-2 mt-4 font-extrabold leading-[0.95] tracking-tight" style="font-size: var(--fs-display);">
      Let's talk<span class="text-[var(--accent)]">.</span>
    </h1>
    <p class="rise-3 mt-6 max-w-[34rem] leading-relaxed ink-soft">{t.contacto.saludo.en}</p>

    <div class="reveal mt-12 grid max-w-[38rem] gap-3">
      {channels.map((c) => (
        <div class="card flex items-center justify-between gap-4 p-5">
          <span class="kicker">{c.k}</span>
          {c.href ? (
            <a class="link-accent font-semibold" href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined}>{c.v}</a>
          ) : (
            <span class="font-semibold">{c.v}</span>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
