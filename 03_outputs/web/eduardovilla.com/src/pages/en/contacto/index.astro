---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import contacto from "@data/contacto.json";

const channels = [
  { k: "Email", v: contacto.email, href: `mailto:${contacto.email}` },
  { k: "Phone", v: contacto.telefono, href: `tel:${contacto.telefono.replace(/\s/g, "")}` },
  { k: "WhatsApp", v: "Open chat", href: `https://wa.me/${contacto.whatsapp}` },
  { k: "Where", v: "Córdoba, Veracruz — MX", href: null },
];
---
<Base
  lang="en"
  title="Contact — Eduardo Villa"
  description="Write to me: email, phone or WhatsApp. The door is open."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display rise">Let's talk<span class="text-[var(--accent-text)]">.</span></h1>
    <p class="rise-2 measure lede mt-8 ink-soft">{t.contacto.saludo.en}</p>

    <dl class="mt-14 max-w-[42rem] border-t border-[var(--line)]">
      {channels.map((c, i) => (
        <div class="reveal flex items-baseline justify-between gap-4 border-b border-[var(--line)] py-5" style={`--d:${i * 70}ms`}>
          <dt class="label">{c.k}</dt>
          <dd class="text-right">
            {c.href ? (
              <a class="link-accent font-medium" href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined}>{c.v}</a>
            ) : (
              <span class="font-medium">{c.v}</span>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>
</Base>
