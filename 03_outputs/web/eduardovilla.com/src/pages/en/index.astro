---
import Base from "@layouts/Base.astro";
import Media from "@components/Media.astro";
import AreaCard from "@components/AreaCard.astro";
import ThinkBox from "@components/ThinkBox.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";
import contacto from "@data/contacto.json";

const title = "Eduardo Villa — " + t.home.tagline.en;
const description =
  "Eduardo Villa's personal site: design, code, systems, automation and play. A digital refuge of what I build, think and learn.";
const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
const byslug = Object.fromEntries(ordenadas.map((a) => [a.slug, a]));
const wa = `https://wa.me/${contacto.whatsapp}`;
const stats = [
  { n: "7+", label: "years of experience" },
  { n: "800+", label: "Lark users" },
  { n: "$5M", label: "in sales" },
  { n: "20+", label: "marketplace account" },
  { n: "25+", label: "parallel projects" },
];
const proyectos = [
  { area: "comercio-electronico", title: "Multi-marketplace storefront", desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.", year: "2026" },
  { area: "inteligencia-artificial", title: "AI automations", desc: "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.", year: "2025" },
  { area: "desarrollo-web", title: "Custom ERP", desc: "Excepteur sint occaecat cupidatat non proident, sunt in culpa.", year: "2024" },
];
const articulos = [
  { title: "Why this site exists", desc: "A generalist needs a refuge of their own.", date: "2026-10-01" },
  { title: "A digital diagnosis in one afternoon", desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.", date: "2026-09-01" },
  { title: "From design to systems", desc: "Ut enim ad minim veniam, quis nostrud exercitation.", date: "2026-08-01" },
];
---
<Base lang="en" title={title} description={description}>
  <!-- Masthead -->
  <section class="hero pt-14">
    <div class="hero__grid">
      <h1 class="hero__name display rise">
        Eduardo<br />Villa
        <span class="rule-accent" aria-hidden="true"></span>
      </h1>

      <div class="hero__body rise-2">
        <p class="hero__intro whitespace-pre-line text-pretty">{t.home.intro.en}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/en/proyectos" class="btn btn-accent">{t.home.verAreas.en} <span class="btn__arrow">→</span></a>
          <a href="/en/contacto" class="btn">Let's talk</a>
        </div>
      </div>

      <Media
        class="hero__media rise-2"
        src="/img/retrato.jpg"
        alt={t.home.heroImageAlt.en}
        ratio="4 / 5"
        caption={t.home.heroImageCaption.en}
        placeholder={t.home.imgPlaceholder.en}
      />
    </div>
  </section>

  <!-- Areas of interest -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="areas-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="areas-title" class="display-2 reveal">{t.home.areasTitle.en}</h2>
      <a href="/en/areas" class="link-accent hidden text-sm sm:inline">See all →</a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {ordenadas.map((a, i) => (
        <AreaCard
          href={`/en/areas/${a.slug}`}
          slug={a.slug}
          num={String(i + 1).padStart(2, "0")}
          title={a.titulo.en}
          lema={a.lema.en}
          more={t.home.leerMas.en}
          delay={i * 55}
        />
      ))}
    </div>
  </section>

  <!-- Purpose -->
  <section class="band mt-24 py-14" aria-labelledby="proposito-title">
    <h2 id="proposito-title" class="label reveal">Purpose</h2>
    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(12rem,1fr)_4fr] lg:gap-16">
      <div class="reveal order-2 flex items-center justify-center lg:order-1">
        <ThinkBox label="Think outside the box" />
      </div>
      <div class="order-1 lg:order-2">
        <p class="display-2 reveal measure">Being a generalist profile</p>
        <p class="display-2 reveal measure">Is having an <span class="font-sans font-bold">integral vision</span>.</p>
        <p class="reveal mt-8 measure whitespace-pre-line ink-soft">{t.proposito.cuerpo.en}</p>
      </div>
    </div>
  </section>

  <!-- Teams -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="equipos-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="equipos-title" class="display-2 reveal">{t.home.equipos.en}</h2>
      <span class="label hidden sm:inline">{t.home.equiposMeta.en}</span>
    </div>
    <p class="reveal mt-6 measure text-base">{t.home.equiposFrase.en}</p>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-6">
      <Media
        class="reveal sm:col-span-2"
        src="/img/impacto-01.jpg"
        alt={t.home.equiposAlt.en}
        ratio="3 / 2"
        index="01"
        placeholder={t.home.imgPlaceholder.en}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:70ms"
        src="/img/impacto-02.jpg"
        alt={t.home.equiposAlt.en}
        ratio="3 / 2"
        index="02"
        placeholder={t.home.imgPlaceholder.en}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:140ms"
        src="/img/impacto-03.jpg"
        alt={t.home.equiposAlt.en}
        ratio="3 / 2"
        index="03"
        placeholder={t.home.imgPlaceholder.en}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:210ms"
        src="/img/impacto-04.jpg"
        alt={t.home.equiposAlt.en}
        ratio="3 / 2"
        index="04"
        placeholder={t.home.imgPlaceholder.en}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:280ms"
        src="/img/impacto-05.jpg"
        alt={t.home.equiposAlt.en}
        ratio="3 / 2"
        index="05"
        placeholder={t.home.imgPlaceholder.en}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:350ms"
        src="/img/impacto-06.jpg"
        alt={t.home.equiposAlt.en}
        ratio="3 / 2"
        index="06"
        placeholder={t.home.imgPlaceholder.en}
      />
    </div>
  </section>

  <!-- Results -->
  <section class="band mt-24 py-14" aria-labelledby="resultados-title">
    <h2 id="resultados-title" class="display-2 reveal">Results</h2>
    <dl class="mt-8 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
      {stats.map((s, i) => (
        <div class="reveal border-t border-[var(--line)] pt-4" style={`--d:${i * 70}ms`}>
          <dt class="display-2 tabular-nums" data-count={s.n}>{s.n}</dt>
          <dd class="label mt-2 whitespace-nowrap">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Projects -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="proyectos-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="proyectos-title" class="display-2 reveal">{t.home.proyectosTitle.en}</h2>
      <a href="/en/proyectos" class="link-accent hidden text-sm sm:inline">{t.home.verTodos.en} →</a>
    </div>
    <ul class="mt-10 border-t border-[var(--line)]">
      {proyectos.map((p, i) => (
        <li class="border-b border-[var(--line)]">
          <a href="/en/proyectos" class="reveal group grid gap-2 py-8 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8" style={`--d:${Math.min(i * 60, 240)}ms`}>
            <span>
              <span class="label">{byslug[p.area]?.titulo.en ?? p.area}</span>
              <span class="display-3 mt-2 block transition-colors group-hover:text-[var(--accent-text)]">{p.title}</span>
              <span class="measure mt-2 block text-sm ink-soft">{p.desc}</span>
            </span>
            <span class="label tabular-nums">{p.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Articles -->
  <section class="band mt-24 py-14" aria-labelledby="articulos-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="articulos-title" class="display-2 reveal">{t.home.articulosTitle.en}</h2>
      <a href="/en/blog" class="link-accent hidden text-sm sm:inline">{t.home.verTodos.en} →</a>
    </div>
    <ul class="mt-10 border-t border-[var(--line)]">
      {articulos.map((a, i) => (
        <li class="border-b border-[var(--line)]">
          <a href="/en/blog" class="reveal group grid gap-2 py-6 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8" style={`--d:${Math.min(i * 60, 240)}ms`}>
            <span>
              <span class="display-3 block transition-colors group-hover:text-[var(--accent-text)]">{a.title}</span>
              <span class="measure mt-2 block text-sm ink-soft">{a.desc}</span>
            </span>
            <time class="label tabular-nums" datetime={a.date}>
              {new Date(a.date).toLocaleDateString("en-US", { year: "numeric", month: "long" })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Close -->
  <section class="mt-24 border-t border-[var(--line)] pt-16 pb-8">
    <span class="label reveal block">{t.home.cierreLabel.en}</span>
    <p class="display-2 reveal measure mt-4">{t.home.cierreTitulo.en}</p>
    <a href={wa} target="_blank" rel="noopener" class="btn btn-accent reveal mt-8">
      {t.contacto.ctaWhatsapp.en} <span class="btn__arrow" aria-hidden="true">→</span>
    </a>
  </section>
</Base>
