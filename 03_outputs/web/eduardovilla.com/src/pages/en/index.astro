---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

const title = "Eduardo Villa — " + t.home.tagline.en;
const description =
  "Eduardo Villa's personal site: design, code, systems, automation and play. A digital refuge of what I build, think and learn.";
const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
const marquee = ["Digital Transformation", "AI", "E-commerce", "Branding", "Minimalism", "Video Games", "Automation", "Design"];
const stats = [
  { n: "7+", label: "years solving" },
  { n: "800+", label: "Lark users" },
  { n: "$5M", label: "MXN / month in sales" },
  { n: "20+", label: "marketplaces" },
];
---
<Base lang="en" title={title} description={description}>
  <!-- Hero -->
  <section class="relative flex min-h-[86vh] flex-col justify-center py-20">
    <div class="flex items-center gap-2 rise">
      <span class="pulse-dot"></span>
      <span class="kicker">Creative generalist</span>
    </div>

    <h1 class="rise-2 mt-6 font-extrabold leading-[0.92] tracking-tight" style="font-size: var(--fs-display);">
      Eduardo<br />
      <span class="grad-text">Villa</span>
    </h1>

    <p class="rise-3 mt-8 max-w-[38rem] text-[var(--fs-lede)] leading-relaxed ink-soft">
      {t.home.intro.en}
    </p>

    <div class="rise-3 mt-9 flex flex-wrap gap-3">
      <a href="/en/areas" class="btn btn-accent">{t.home.verAreas.en} →</a>
      <a href="/en/contacto" class="btn">Let's talk</a>
    </div>
  </section>

  <!-- Marquee -->
  <section class="relative -mx-[var(--gutter)] border-y border-line py-4" aria-hidden="true">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee__track">
          {[...marquee, ...marquee].map((w) => (
            <span class="flex items-center gap-2 whitespace-nowrap text-sm tracking-wide ink-faint">
              <span class="text-[var(--accent)]">✦</span>{w}
            </span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- Areas -->
  <section class="py-20" aria-labelledby="areas-title">
    <div class="reveal flex items-end justify-between gap-4">
      <div>
        <p class="kicker">{t.home.areasKicker.en}</p>
        <h2 id="areas-title" class="mt-3 font-bold" style="font-size: var(--fs-h2);">Six lenses</h2>
      </div>
      <a href="/en/areas" class="link-accent hidden text-sm sm:block">See all →</a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {ordenadas.map((a) => (
        <a href={`/en/areas/${a.slug}`} class="card reveal group flex flex-col gap-4 p-6">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl text-lg text-[var(--accent)]" style="background: var(--accent-soft);" aria-hidden="true">{a.icono}</span>
          <span class="flex items-center justify-between gap-2">
            <span class="font-semibold group-hover:text-[var(--accent)] transition-colors">{a.titulo.en}</span>
            <span class="text-[var(--ink-faint)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--accent)]">→</span>
          </span>
          <span class="text-sm leading-relaxed ink-soft">{a.lema.en}</span>
          {a.mision && <span class="tag mt-auto w-fit">The mission</span>}
        </a>
      ))}
    </div>
  </section>

  <!-- Manifesto -->
  <section class="reveal relative overflow-hidden rounded-[var(--radius)] border border-line px-6 py-14 sm:px-12" style="background: var(--surface);">
    <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full" style="background: radial-gradient(circle, var(--accent-glow), transparent 70%);" aria-hidden="true"></div>
    <p class="kicker">Manifesto</p>
    <h2 class="mt-4 max-w-[46rem] font-bold leading-[1.08]" style="font-size: var(--fs-h2);">
      The generalist isn't indecision:<br /><span class="grad-text">it's integral vision.</span>
    </h2>
    <p class="mt-6 max-w-[40rem] leading-relaxed ink-soft">{t.manifiesto.cuerpo.en}</p>
  </section>

  <!-- Stats -->
  <section class="reveal mt-20 grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius)] border border-line md:grid-cols-4" style="background: var(--line);">
    {stats.map((s) => (
      <div class="flex flex-col gap-1 p-6" style="background: var(--bg);">
        <span class="font-extrabold tracking-tight text-[var(--accent)]" style="font-size: clamp(1.8rem, 4vw, 2.6rem);">{s.n}</span>
        <span class="text-xs ink-soft">{s.label}</span>
      </div>
    ))}
  </section>

  <!-- CTA -->
  <section class="reveal mt-20 flex flex-col items-start justify-between gap-6 rounded-[var(--radius)] border border-line p-8 sm:flex-row sm:items-center sm:p-10" style="background: var(--surface);">
    <p class="max-w-[30rem] text-lg font-medium">
      A business with digital mess, or an idea worth building?
    </p>
    <a href="/en/contacto" class="btn btn-accent shrink-0">Write to me →</a>
  </section>
</Base>
