---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
---
<Base
  lang="en"
  title={`${t.listas.indexTitle.en} — Eduardo Villa`}
  description="Eduardo Villa's projects: stores, systems, brands and experiments. The real work, when it's ready."
>
  <section class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.listas.indexTitle.en}</p>
    <h1 class="mt-3 font-semibold" style="font-size: var(--fs-h2);">
      Built work
    </h1>
    <p class="mt-4 max-w-[34rem] text-[var(--ink-soft)]">
      This is where the project record will live — each one tagged with its area.
      Placeholder for now: real content goes in once approved.
    </p>
    <div class="mt-12 divide-y rule border-y rule">
      {Array.from({ length: 4 }).map((_, i) => (
        <article class="grid gap-1 py-6 md:grid-cols-[8rem_1fr_5rem] md:items-baseline" aria-hidden="true">
          <p class="kicker">Project {String(i + 1).padStart(2, "0")}</p>
          <p class="font-semibold">Lorem ipsum dolor sit amet</p>
          <p class="text-sm text-[var(--ink-faint)]">2026</p>
          <p class="max-w-[38rem] text-sm text-[var(--ink-soft)] md:col-start-2">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.
          </p>
        </article>
      ))}
    </div>
  </section>
</Base>
