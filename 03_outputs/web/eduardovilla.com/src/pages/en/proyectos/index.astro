---
import Base from "@layouts/Base.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { t } from "@i18n/ui";
import { proyectoSlug } from "@/lib/proyectos";
import areas from "@data/areas.json";

const byslug = Object.fromEntries(areas.map((a) => [a.slug, a]));
const proyectos = (
  await getCollection("proyectos", ({ data }) => data.lang === "en" && !data.draft)
).sort(
  (a, b) =>
    Number(b.data.destacado) - Number(a.data.destacado) ||
    b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  lang="en"
  title={`${t.listas.indexTitle.en} — Eduardo Villa`}
  description="Eduardo Villa's projects: brands, stores, systems and experiments, each with its process."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">Built work.</h1>
    <p class="rise-2 mt-6 measure ink-soft">
      Each project is tagged with its area and year. The real work, with its process.
    </p>
  </section>

  <section class="mt-14">
    {proyectos.length === 0 && (
      <p class="border-t border-[var(--line)] pt-6 text-sm ink-soft">{t.listas.vacio.en}</p>
    )}
    <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
      {proyectos.map((p, i) => (
        <ProjectCard
          href={`/en/proyectos/${proyectoSlug(p.id)}/`}
          title={p.data.shortTitle ?? p.data.title}
          description={p.data.description}
          areaLabel={byslug[p.data.area]?.titulo.en ?? p.data.area}
          year={p.data.year}
          cover={p.data.cover}
          coverAlt={p.data.coverAlt}
          index={String(i + 1).padStart(2, "0")}
          placeholder={t.home.imgPlaceholder.en}
          delay={i * 60}
        />
      ))}
    </div>
  </section>
</Base>
