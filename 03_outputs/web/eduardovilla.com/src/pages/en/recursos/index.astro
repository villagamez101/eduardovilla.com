---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
---
<Base
  lang="en"
  title={`${t.recursos.indexTitle.en} — Eduardo Villa`}
  description="Eduardo Villa's resources: downloadable CV, templates and guides under construction."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">Take it and use it.</h1>
    <p class="rise-2 mt-6 measure ink-soft">{t.recursos.nota.en}</p>
  </section>

  <section class="mt-14">
    <ul class="border-t border-[var(--line)]">
      <li class="border-b border-[var(--line)]">
        <a
          href="/recursos/cv-eduardo-villa-2026.pdf"
          download
          class="reveal group grid gap-2 py-8 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8"
        >
          <span>
            <span class="display-3 block transition-colors group-hover:text-[var(--accent-text)]">CV — Eduardo Villa (2026)</span>
            <span class="mt-2 block text-sm ink-soft">Full trajectory, as a PDF (Spanish).</span>
          </span>
          <span class="label text-[var(--accent-text)]">Download PDF →</span>
        </a>
      </li>
      <li class="border-b border-[var(--line)]">
        <div class="reveal grid gap-2 py-8 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8" style="--d:80ms">
          <span>
            <span class="display-3 block ink-soft">Guide: a digital diagnosis in one afternoon</span>
            <span class="mt-2 block text-sm ink-faint">Under construction.</span>
          </span>
          <span class="label">Soon</span>
        </div>
      </li>
    </ul>
  </section>
</Base>
