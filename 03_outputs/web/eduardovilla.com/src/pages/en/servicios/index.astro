---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";
import servicios from "@data/servicios.json";

const byslug = Object.fromEntries(areas.map((a) => [a.slug, a]));
---
<Base
  lang="en"
  title={`${t.servicios.indexTitle.en} — Eduardo Villa`}
  description="How I can help: diagnosis, digital presence, e-commerce, automation and identity — integrated, not in loose pieces."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">Digital architecture, not loose pieces.</h1>
    <p class="rise-2 mt-6 measure ink-soft">{t.servicios.nota.en}</p>
  </section>

  <ol class="mt-14 border-t border-[var(--line)]">
    {servicios.map((s, i) => (
      <li class="border-b border-[var(--line)]">
        <article class="reveal grid gap-3 py-8 md:grid-cols-[3rem_1fr_14rem] md:items-baseline md:gap-8" style={`--d:${Math.min(i * 60, 240)}ms`}>
          <span class="label tabular-nums">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2 class="display-3">{s.titulo.en}</h2>
            <p class="measure mt-3 text-sm ink-soft">{s.descripcion.en}</p>
          </div>
          <a href={`/en/areas/${s.area}`} class="group flex items-baseline gap-2 text-sm md:justify-self-end">
            <span class="ink-faint" aria-hidden="true">↳</span>
            <span class="link-accent group-hover:opacity-100">{byslug[s.area]?.titulo.en ?? s.area}</span>
          </a>
        </article>
      </li>
    ))}
  </ol>

  <section class="mt-16 border-t border-[var(--line)] pt-12">
    <p class="display-2 measure">Does the problem sound familiar?</p>
    <a href="/en/contacto" class="btn btn-accent mt-8">Let's talk →</a>
  </section>
</Base>
