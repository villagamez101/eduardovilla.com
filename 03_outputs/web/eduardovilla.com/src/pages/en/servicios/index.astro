---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";
import servicios from "@data/servicios.json";

const l = "en" as const;
const byslug = Object.fromEntries(areas.map((a) => [a.slug, a]));
---
<Base
  lang="en"
  title={`${t.servicios.indexTitle.en} — Eduardo Villa`}
  description="How I can help: diagnosis, digital presence, e-commerce, automation and identity — integrated, not in loose pieces."
>
  <section class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.servicios.indexTitle.en}</p>
    <h1 class="mt-3 max-w-[40rem] font-semibold leading-tight" style="font-size: var(--fs-h2);">
      Digital architecture, not loose pieces.
    </h1>
    <p class="mt-4 max-w-[34rem] text-[var(--ink-soft)]">{t.servicios.nota.en}</p>

    <ol class="mt-12 divide-y rule border-y rule">
      {servicios.map((s, i) => (
        <li class="grid gap-2 py-6 md:grid-cols-[3rem_1fr_10rem] md:items-baseline">
          <span class="text-sm text-[var(--ink-faint)]">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2 class="font-semibold">{s.titulo.en}</h2>
            <p class="mt-1 max-w-[38rem] text-sm leading-relaxed text-[var(--ink-soft)]">{s.descripcion.en}</p>
          </div>
          <a href={`/en/areas/${s.area}`} class="a-link text-xs md:text-right">
            {byslug[s.area]?.titulo.en ?? s.area}
          </a>
        </li>
      ))}
    </ol>

    <p class="mt-8 max-w-[34rem] text-sm text-[var(--ink-soft)]">
      Does the problem sound familiar?
      <a href="/en/contacto" class="a-link">Write to me</a> — the first conversation is just that: a conversation.
    </p>
  </section>
</Base>
