---
import Base from "@layouts/Base.astro";
import Media from "@components/Media.astro";
import AreaCard from "@components/AreaCard.astro";
import ThinkBox from "@components/ThinkBox.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";
import contacto from "@data/contacto.json";

const l = "es" as const;
const title = "Eduardo Villa — " + t.home.tagline.es;
const description =
  "Sitio personal de Eduardo Villa: diseño, código, sistemas, automatización y juego. Un refugio digital de lo que construyo, pienso y aprendo.";
const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
const byslug = Object.fromEntries(ordenadas.map((a) => [a.slug, a]));
const wa = `https://wa.me/${contacto.whatsapp}`;
const stats = [
  { n: "7+", label: "años de experiencia" },
  { n: "800+", label: "usuarios en Lark" },
  { n: "$5M", label: "de pesos en ventas" },
  { n: "20+", label: "cuenta marketplace" },
  { n: "25+", label: "proyectos paralelo" },
];
const proyectos = [
  { area: "comercio-electronico", title: "Tienda y catálogo multi-marketplace", desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.", year: "2026" },
  { area: "inteligencia-artificial", title: "Automatizaciones con IA", desc: "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.", year: "2025" },
  { area: "desarrollo-web", title: "ERP a la medida", desc: "Excepteur sint occaecat cupidatat non proident, sunt in culpa.", year: "2024" },
];
const articulos = [
  { title: "Por qué este sitio existe", desc: "Un generalista necesita un refugio propio.", date: "2026-10-01" },
  { title: "Diagnóstico digital en una tarde", desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.", date: "2026-09-01" },
  { title: "Del diseño a los sistemas", desc: "Ut enim ad minim veniam, quis nostrud exercitation.", date: "2026-08-01" },
];
---
<Base lang="es" title={title} description={description}>
  <!-- Cabecera -->
  <section class="hero pt-14">
    <div class="hero__grid">
      <h1 class="hero__name display rise">
        Eduardo<br />Villa
        <span class="rule-accent" aria-hidden="true"></span>
      </h1>

      <div class="hero__body rise-2">
        <p class="hero__intro whitespace-pre-line text-pretty">{t.home.intro.es}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/proyectos" class="btn btn-accent">{t.home.verAreas.es} <span class="btn__arrow">→</span></a>
          <a href="/contacto" class="btn">Hablemos</a>
        </div>
      </div>

      <Media
        class="hero__media rise-2"
        src="/img/retrato.jpg"
        alt={t.home.heroImageAlt.es}
        ratio="4 / 5"
        caption={t.home.heroImageCaption.es}
        placeholder={t.home.imgPlaceholder.es}
      />
    </div>
  </section>

  <!-- Áreas de interés -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="areas-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="areas-title" class="display-2 reveal">{t.home.areasTitle.es}</h2>
      <a href="/areas" class="link-accent hidden text-sm sm:inline">Ver todas →</a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {ordenadas.map((a, i) => (
        <AreaCard
          href={`/areas/${a.slug}`}
          slug={a.slug}
          num={String(i + 1).padStart(2, "0")}
          title={a.titulo.es}
          lema={a.lema.es}
          more={t.home.leerMas.es}
          delay={i * 55}
        />
      ))}
    </div>
  </section>

  <!-- Propósito -->
  <section class="band mt-24 py-14" aria-labelledby="proposito-title">
    <h2 id="proposito-title" class="label reveal">Propósito</h2>
    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(12rem,1fr)_4fr] lg:gap-16">
      <div class="reveal order-2 flex items-center justify-center lg:order-1">
        <ThinkBox label="Pensar fuera de la caja" />
      </div>
      <div class="order-1 lg:order-2">
        <p class="display-2 reveal measure">Ser un perfil generalista</p>
        <p class="display-2 reveal measure">Es tener <span class="font-sans font-bold">Visión integral</span>.</p>
        <p class="reveal mt-8 measure whitespace-pre-line ink-soft">{t.proposito.cuerpo.es}</p>
      </div>
    </div>
  </section>

  <!-- Equipos -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="equipos-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="equipos-title" class="display-2 reveal">{t.home.equipos.es}</h2>
      <span class="label hidden sm:inline">{t.home.equiposMeta.es}</span>
    </div>
    <p class="reveal mt-6 measure text-base">{t.home.equiposFrase.es}</p>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-6">
      <Media
        class="reveal sm:col-span-2"
        src="/img/impacto-01.jpg"
        alt={t.home.equiposAlt.es}
        ratio="3 / 2"
        lightbox
        zoomLabel={t.home.ampliar.es}
        index="01"
        placeholder={t.home.imgPlaceholder.es}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:70ms"
        src="/img/impacto-02.jpg"
        alt={t.home.equiposAlt.es}
        ratio="3 / 2"
        lightbox
        zoomLabel={t.home.ampliar.es}
        index="02"
        placeholder={t.home.imgPlaceholder.es}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:140ms"
        src="/img/impacto-03.jpg"
        alt={t.home.equiposAlt.es}
        ratio="3 / 2"
        lightbox
        zoomLabel={t.home.ampliar.es}
        index="03"
        placeholder={t.home.imgPlaceholder.es}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:210ms"
        src="/img/impacto-04.jpg"
        alt={t.home.equiposAlt.es}
        ratio="3 / 2"
        lightbox
        zoomLabel={t.home.ampliar.es}
        index="04"
        placeholder={t.home.imgPlaceholder.es}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:280ms"
        src="/img/impacto-05.jpg"
        alt={t.home.equiposAlt.es}
        ratio="3 / 2"
        lightbox
        zoomLabel={t.home.ampliar.es}
        index="05"
        placeholder={t.home.imgPlaceholder.es}
      />
      <Media
        class="reveal sm:col-span-2"
        style="--d:350ms"
        src="/img/impacto-06.jpg"
        alt={t.home.equiposAlt.es}
        ratio="3 / 2"
        lightbox
        zoomLabel={t.home.ampliar.es}
        index="06"
        placeholder={t.home.imgPlaceholder.es}
      />
    </div>
  </section>

  <!-- Resultados -->
  <section class="band mt-24 py-14" aria-labelledby="resultados-title">
    <h2 id="resultados-title" class="display-2 reveal">Resultados</h2>
    <dl class="mt-8 grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
      {stats.map((s, i) => (
        <div class="reveal border-t border-[var(--line)] pt-4" style={`--d:${i * 70}ms`}>
          <dt class="display-2 tabular-nums" data-count={s.n}>{s.n}</dt>
          <dd class="label mt-2 whitespace-nowrap">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Proyectos -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="proyectos-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="proyectos-title" class="display-2 reveal">{t.home.proyectosTitle.es}</h2>
      <a href="/proyectos" class="link-accent hidden text-sm sm:inline">{t.home.verTodos.es} →</a>
    </div>
    <ul class="mt-10 border-t border-[var(--line)]">
      {proyectos.map((p, i) => (
        <li class="border-b border-[var(--line)]">
          <a href="/proyectos" class="reveal group grid gap-2 py-8 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8" style={`--d:${Math.min(i * 60, 240)}ms`}>
            <span>
              <span class="label">{byslug[p.area]?.titulo.es ?? p.area}</span>
              <span class="display-3 mt-2 block transition-colors group-hover:text-[var(--accent-text)]">{p.title}</span>
              <span class="measure mt-2 block text-sm ink-soft">{p.desc}</span>
            </span>
            <span class="label tabular-nums">{p.year}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Artículos -->
  <section class="band mt-24 py-14" aria-labelledby="articulos-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="articulos-title" class="display-2 reveal">{t.home.articulosTitle.es}</h2>
      <a href="/blog" class="link-accent hidden text-sm sm:inline">{t.home.verTodos.es} →</a>
    </div>
    <ul class="mt-10 border-t border-[var(--line)]">
      {articulos.map((a, i) => (
        <li class="border-b border-[var(--line)]">
          <a href="/blog" class="reveal group grid gap-2 py-6 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8" style={`--d:${Math.min(i * 60, 240)}ms`}>
            <span>
              <span class="display-3 block transition-colors group-hover:text-[var(--accent-text)]">{a.title}</span>
              <span class="measure mt-2 block text-sm ink-soft">{a.desc}</span>
            </span>
            <time class="label tabular-nums" datetime={a.date}>
              {new Date(a.date).toLocaleDateString("es-MX", { year: "numeric", month: "long" })}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Cierre -->
  <section class="mt-24 border-t border-[var(--line)] pt-16 pb-8">
    <span class="label reveal block">{t.home.cierreLabel.es}</span>
    <p class="display-2 reveal measure mt-4">{t.home.cierreTitulo.es}</p>
    <a href={wa} target="_blank" rel="noopener" class="btn btn-accent reveal mt-8">
      {t.contacto.ctaWhatsapp.es} <span class="btn__arrow" aria-hidden="true">→</span>
    </a>
  </section>
</Base>
