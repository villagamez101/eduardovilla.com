---
import Base from "@layouts/Base.astro";
import Media from "@components/Media.astro";
import AreaCard from "@components/AreaCard.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

const l = "es" as const;
const title = "Eduardo Villa — " + t.home.tagline.es;
const description =
  "Sitio personal de Eduardo Villa: diseño, código, sistemas, automatización y juego. Un refugio digital de lo que construyo, pienso y aprendo.";
const ordenadas = [...areas].sort((a, b) => a.orden - b.orden);
const stats = [
  { n: "7+", label: "años resolviendo" },
  { n: "800+", label: "usuarios en Lark" },
  { n: "$5M", label: "MXN / mes en ventas" },
  { n: "20+", label: "marketplaces" },
];
---
<Base lang="es" title={title} description={description}>
  <!-- Cabecera -->
  <section class="hero pt-14">
    <div class="flex items-baseline justify-between gap-4 border-b border-[var(--line-strong)] pb-3">
      <span class="label">Transformación digital</span>
      <span class="label">Soluciones digitales</span>
    </div>

    <div class="hero__grid mt-10 sm:mt-16">
      <h1 class="hero__name display rise">
        Eduardo<br />Villa
        <span class="rule-accent" aria-hidden="true"></span>
      </h1>

      <div class="hero__body rise-2">
        <p class="hero__intro whitespace-pre-line text-pretty">{t.home.intro.es}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/proyectos" class="btn btn-accent">{t.home.verAreas.es} <span class="btn__arrow">→</span></a>
          <a href="/contacto" class="btn">Hablemos</a>
        </div>
      </div>

      <Media
        class="hero__media rise-2"
        src="/img/retrato.jpg"
        alt={t.home.heroImageAlt.es}
        ratio="4 / 5"
        caption={t.home.heroImageCaption.es}
        placeholder={t.home.imgPlaceholder.es}
      />
    </div>
  </section>

  <!-- Áreas de interés -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="areas-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="areas-title" class="display-2 reveal">{t.home.areasTitle.es}</h2>
      <a href="/areas" class="link-accent hidden text-sm sm:inline">Ver todas →</a>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {ordenadas.map((a, i) => (
        <AreaCard
          href={`/areas/${a.slug}`}
          slug={a.slug}
          num={String(i + 1).padStart(2, "0")}
          title={a.titulo.es}
          lema={a.lema.es}
          more={t.home.leerMas.es}
          delay={i * 55}
        />
      ))}
    </div>
  </section>

  <!-- Propósito -->
  <section class="mt-24 border-t border-[var(--line)] pt-14">
    <div class="grid gap-6 lg:grid-cols-[10rem_1fr] lg:gap-10">
      <span class="label reveal lg:pt-4">Propósito</span>
      <div>
        <p class="display-2 reveal measure">
          Ser un perfil generalista<br />
          Es tener <span class="font-sans font-bold">Visión integral</span>.
        </p>
        <p class="reveal mt-8 measure whitespace-pre-line ink-soft">{t.proposito.cuerpo.es}</p>
      </div>
    </div>
  </section>

  <!-- En el taller -->
  <section class="mt-24 border-t border-[var(--line)] pt-14" aria-labelledby="taller-title">
    <div class="flex items-end justify-between gap-4">
      <h2 id="taller-title" class="display-2 reveal">{t.home.taller.es}</h2>
      <span class="label hidden sm:inline">{t.home.tallerMeta.es}</span>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <Media
        class="reveal"
        src="/img/taller-01.jpg"
        ratio="4 / 5"
        index="01"
        caption={t.home.imgCaption.es}
        placeholder={t.home.imgPlaceholder.es}
      />
      <Media
        class="reveal"
        style="--d:80ms"
        src="/img/taller-02.jpg"
        ratio="4 / 5"
        index="02"
        caption={t.home.imgCaption.es}
        placeholder={t.home.imgPlaceholder.es}
      />
      <Media
        class="reveal"
        style="--d:160ms"
        src="/img/taller-03.jpg"
        ratio="4 / 5"
        index="03"
        caption={t.home.imgCaption.es}
        placeholder={t.home.imgPlaceholder.es}
      />
    </div>
  </section>

  <!-- Cifras -->
  <section class="mt-24 border-t border-[var(--line)] pt-14">
    <span class="label reveal block">Cifras</span>
    <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-4">
      {stats.map((s, i) => (
        <div class="reveal border-t border-[var(--line)] pt-4" style={`--d:${i * 70}ms`}>
          <dt class="display-2 tabular-nums" data-count={s.n}>{s.n}</dt>
          <dd class="label mt-2">{s.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Cierre -->
  <section class="mt-24 border-t border-[var(--line)] pt-16 pb-8">
    <p class="display-2 reveal measure">
      ¿Un negocio con desorden digital o una idea que merece construirse?
    </p>
    <a href="/contacto" class="btn btn-accent reveal mt-8">Escríbeme <span class="btn__arrow">→</span></a>
  </section>
</Base>
