---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";

const byslug = Object.fromEntries(areas.map((a) => [a.slug, a]));
const demo = [
  { area: "ecommerce-desarrollo-web", title: "Lorem ipsum storefront", desc: "Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.", year: "2026" },
  { area: "ia-automatizacion", title: "Lorem ipsum automations", desc: "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.", year: "2025" },
  { area: "branding-diseno", title: "Lorem ipsum identity", desc: "Duis aute irure dolor in reprehenderit in voluptate velit esse.", year: "2025" },
  { area: "transformacion-digital", title: "Lorem ipsum ERP", desc: "Excepteur sint occaecat cupidatat non proident, sunt in culpa.", year: "2024" },
];
---
<Base
  lang="es"
  title={`${t.listas.indexTitle.es} — Eduardo Villa`}
  description="Proyectos de Eduardo Villa: tiendas, sistemas, marcas y experimentos. El trabajo real, cuando esté listo."
>
  <section class="mt-14 border-t border-[var(--line)] pt-12">
    <h1 class="display-2 rise measure">Lo construido.</h1>
    <p class="rise-2 mt-6 measure ink-soft">
      {t.listas.vacio.es} Cada proyecto se etiqueta con su área.
    </p>
  </section>

  <section class="mt-14">
    <ul class="border-t border-[var(--line)]">
      {demo.map((p, i) => (
        <li class="border-b border-[var(--line)]">
          <article class="reveal grid gap-2 py-8 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8" style={`--d:${Math.min(i * 60, 240)}ms`}>
            <div>
              <span class="label">{byslug[p.area]?.titulo.es ?? p.area}</span>
              <h2 class="display-3 mt-2">{p.title}</h2>
              <p class="measure mt-2 text-sm ink-soft">{p.desc}</p>
            </div>
            <span class="label tabular-nums">{p.year}</span>
          </article>
          <span class="label -mt-4 mb-8 block">Placeholder — se reemplaza con el proyecto real</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
