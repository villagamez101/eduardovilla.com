---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import contacto from "@data/contacto.json";
---
<Base
  lang="es"
  title={`${t.recursos.indexTitle.es} — Eduardo Villa`}
  description="Recursos de Eduardo Villa: CV descargable, plantillas y guías en construcción."
>
  <section class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.recursos.indexTitle.es}</p>
    <h1 class="mt-3 font-semibold" style="font-size: var(--fs-h2);">
      Para tomar y usar.
    </h1>
    <p class="mt-4 max-w-[34rem] text-[var(--ink-soft)]">{t.recursos.nota.es}</p>

    <ol class="mt-12 divide-y rule border-y rule">
      <li class="grid gap-2 py-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="font-semibold">CV — Eduardo Villa (2026)</h2>
          <p class="mt-1 text-sm text-[var(--ink-soft)]">Trayectoria completa, en PDF.</p>
        </div>
        <a class="a-link text-sm" href="/recursos/cv-eduardo-villa-2026.pdf" download>Descargar PDF</a>
      </li>
      <li class="grid gap-2 py-6 md:grid-cols-[1fr_auto] md:items-center opacity-40" aria-hidden="true">
        <div>
          <h2 class="font-semibold">Guía: diagnóstico digital en una tarde</h2>
          <p class="mt-1 text-sm text-[var(--ink-soft)]">En construcción.</p>
        </div>
        <span class="text-sm text-[var(--ink-faint)]">Pronto</span>
      </li>
    </ol>
  </section>
</Base>
