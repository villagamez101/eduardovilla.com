---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
---
<Base
  lang="es"
  title={`${t.recursos.indexTitle.es} — Eduardo Villa`}
  description="Recursos de Eduardo Villa: CV descargable, plantillas y guías en construcción."
>
  <section class="py-16">
    <p class="kicker rise">{t.recursos.indexTitle.es}</p>
    <h1 class="rise-2 mt-4 font-extrabold leading-[0.98] tracking-tight" style="font-size: var(--fs-h2);">
      Para <span class="grad-text">tomar y usar.</span>
    </h1>
    <p class="rise-3 mt-5 max-w-[36rem] ink-soft">{t.recursos.nota.es}</p>
  </section>

  <section class="grid gap-4 pb-10 sm:grid-cols-2">
    <a href="/recursos/cv-eduardo-villa-2026.pdf" download class="card reveal group flex flex-col gap-4 p-6">
      <span class="flex h-11 w-11 items-center justify-center rounded-xl text-lg text-[var(--accent)]" style="background: var(--accent-soft);">↓</span>
      <h2 class="font-bold group-hover:text-[var(--accent)] transition-colors">CV — Eduardo Villa (2026)</h2>
      <p class="text-sm ink-soft">Trayectoria completa, en PDF.</p>
      <span class="mt-auto text-xs font-semibold text-[var(--accent)]">Descargar PDF →</span>
    </a>
    <div class="card flex flex-col gap-4 p-6 opacity-50">
      <span class="flex h-11 w-11 items-center justify-center rounded-xl text-lg ink-faint" style="background: var(--surface-2);">✦</span>
      <h2 class="font-bold">Guía: diagnóstico digital en una tarde</h2>
      <p class="text-sm ink-soft">En construcción.</p>
      <span class="mt-auto text-xs ink-faint">Pronto</span>
    </div>
  </section>
</Base>
