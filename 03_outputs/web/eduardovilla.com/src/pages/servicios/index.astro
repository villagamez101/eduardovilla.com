---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";
import servicios from "@data/servicios.json";

const byslug = Object.fromEntries(areas.map((a) => [a.slug, a]));
---
<Base
  lang="es"
  title={`${t.servicios.indexTitle.es} — Eduardo Villa`}
  description="Cómo puedo ayudar: diagnóstico, presencia digital, e-commerce, automatización e identidad — integrados, no en piezas sueltas."
>
  <section class="py-16">
    <p class="kicker rise">{t.servicios.indexTitle.es}</p>
    <h1 class="rise-2 mt-4 max-w-[38rem] font-extrabold leading-[0.98] tracking-tight" style="font-size: var(--fs-h2);">
      Arquitectura digital, <span class="grad-text">no piezas sueltas.</span>
    </h1>
    <p class="rise-3 mt-5 max-w-[36rem] ink-soft">{t.servicios.nota.es}</p>
  </section>

  <section class="grid gap-4 pb-10">
    {servicios.map((s, i) => (
      <article class="card reveal grid gap-4 p-6 sm:p-7 md:grid-cols-[3rem_1fr_12rem] md:items-start">
        <span class="font-mono text-sm text-[var(--accent)]">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <h2 class="font-bold">{s.titulo.es}</h2>
          <p class="mt-2 max-w-[42rem] text-sm leading-relaxed ink-soft">{s.descripcion.es}</p>
        </div>
        <a href={`/areas/${s.area}`} class="tag w-fit md:ml-auto">↳ {byslug[s.area]?.titulo.es ?? s.area}</a>
      </article>
    ))}
  </section>

  <section class="reveal mt-10 flex flex-col items-start justify-between gap-6 rounded-[var(--radius)] border border-line p-8 sm:flex-row sm:items-center" style="background: var(--surface);">
    <p class="max-w-[30rem] text-lg font-medium">¿Te suena familiar el problema?</p>
    <a href="/contacto" class="btn btn-accent shrink-0">Conversemos →</a>
  </section>
</Base>
