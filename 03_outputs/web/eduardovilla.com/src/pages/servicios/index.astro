---
import Base from "@layouts/Base.astro";
import { t } from "@i18n/ui";
import areas from "@data/areas.json";
import servicios from "@data/servicios.json";

const byslug = Object.fromEntries(areas.map((a) => [a.slug, a]));
---
<Base
  lang="es"
  title={`${t.servicios.indexTitle.es} — Eduardo Villa`}
  description="Cómo puedo ayudar: diagnóstico, presencia digital, e-commerce, automatización e identidad — integrados, no en piezas sueltas."
>
  <section class="py-[calc(var(--space-unit)*2)]">
    <p class="kicker">{t.servicios.indexTitle.es}</p>
    <h1 class="mt-3 max-w-[40rem] font-semibold leading-tight" style="font-size: var(--fs-h2);">
      Arquitectura digital, no piezas sueltas.
    </h1>
    <p class="mt-4 max-w-[34rem] text-[var(--ink-soft)]">{t.servicios.nota.es}</p>

    <ol class="mt-12 divide-y rule border-y rule">
      {servicios.map((s, i) => (
        <li class="grid gap-2 py-6 md:grid-cols-[3rem_1fr_10rem] md:items-baseline">
          <span class="text-sm text-[var(--ink-faint)]">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h2 class="font-semibold">{s.titulo.es}</h2>
            <p class="mt-1 max-w-[38rem] text-sm leading-relaxed text-[var(--ink-soft)]">{s.descripcion.es}</p>
          </div>
          <a
            href={`/areas/${s.area}`}
            class="a-link text-xs md:text-right"
          >
            {byslug[s.area]?.titulo.es ?? s.area}
          </a>
        </li>
      ))}
    </ol>

    <p class="mt-8 max-w-[34rem] text-sm text-[var(--ink-soft)]">
      ¿Te suena familiar el problema?
      <a href="/contacto" class="a-link">Escríbeme</a> — la primera conversación es solo eso: conversar.
    </p>
  </section>
</Base>
